{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
  },
  // Deliberately omits `**/*.vue`, the common hand-rolled-tsconfig mistake.
  "include": ["**/*.ts"],
}
